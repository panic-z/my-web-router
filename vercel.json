{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/_next/:path*",
      "destination": "/api/proxy?path=_next/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=api/:path*"
    },
    {
      "source": "/ai-info",
      "destination": "/api/proxy?path=ai-info"
    },
    {
      "source": "/ai-info/:path*",
      "destination": "/api/proxy?path=ai-info/:path*"
    },
    {
      "source": "/resume-maker",
      "destination": "/api/proxy?path=resume-maker"
    },
    {
      "source": "/resume-maker/:path*",
      "destination": "/api/proxy?path=resume-maker/:path*"
    }
  ]
}
