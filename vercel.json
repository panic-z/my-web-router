{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "https://resume-maker-omega-ten.vercel.app/assets/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "https://resume-maker-omega-ten.vercel.app/favicon.svg"
    },
    {
      "source": "/icons.svg",
      "destination": "https://resume-maker-omega-ten.vercel.app/icons.svg"
    },
    {
      "source": "/robots.txt",
      "destination": "https://resume-maker-omega-ten.vercel.app/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://resume-maker-omega-ten.vercel.app/sitemap.xml"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://ai-info-eta.vercel.app/_next/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ai-info-eta.vercel.app/api/:path*"
    },
    {
      "source": "/ai-info",
      "destination": "https://ai-info-eta.vercel.app/"
    },
    {
      "source": "/ai-info/:path*",
      "destination": "https://ai-info-eta.vercel.app/:path*"
    },
    {
      "source": "/resume-maker",
      "destination": "https://resume-maker-omega-ten.vercel.app/"
    },
    {
      "source": "/resume-maker/:path*",
      "destination": "https://resume-maker-omega-ten.vercel.app/:path*"
    }
  ]
}
